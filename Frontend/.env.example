# Supabase (get from Supabase project settings → API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Railway backend URLs (set after deploying both services)
VITE_VALIDATION_API_URL=https://your-validation-service.up.railway.app
VITE_ROADMAP_API_URL=https://your-roadmap-service.up.railway.app
