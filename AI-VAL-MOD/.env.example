# LLM
GROQ_API_KEY=<your_groq_api_key>

# Web search fallback
TAVILY_API_KEY=<your_tavily_api_key>

# GitHub — any personal access token (classic), no special scopes needed
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=<your_github_pat>

# Stack Overflow — free key, raises quota from 300 to 10,000 req/day
# Register at: https://stackapps.com/apps/oauth/register
STACKOVERFLOW_KEY=<your_stackoverflow_key>
