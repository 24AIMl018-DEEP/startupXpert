# ── LLM Providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=<your_groq_api_key>
NVIDIA_API_KEY=<your_nvidia_api_key>

# ── Extended Free-Tier Fallback Providers ─────────────────────────────────────
# Add as many as you have — the system skips any with a missing key.
#
# DeepSeek  — https://platform.deepseek.com  ($5 free credit, ~1M tokens)
DEEPSEEK_API_KEY=<your_deepseek_api_key>
#
# Cerebras  — https://cloud.cerebras.ai      (free tier, very fast inference)
CEREBRAS_API_KEY=<your_cerebras_api_key>
#
# OpenRouter  — https://openrouter.ai        (truly free: deepseek/deepseek-r1:free)
OPENROUTER_API_KEY=<your_openrouter_api_key>
#
# Together AI — https://www.together.ai
TOGETHER_API_KEY=<your_together_api_key>
#
# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=<your_gemini_api_key>


# ── Web Search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=<your_tavily_api_key>

# ── Supabase (server-side service role — never expose to frontend) ────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>

# ── CORS (comma-separated list of allowed frontend origins) ──────────────────
# Production: ALLOWED_ORIGINS=https://yourapp.vercel.app
# Development: ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=*

# ── LLM Settings ─────────────────────────────────────────────────────────────
DEFAULT_TEMPERATURE=0.7

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on Railway
ENVIRONMENT=development

# ── Ollama (local fallback only — not used on Railway) ───────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
